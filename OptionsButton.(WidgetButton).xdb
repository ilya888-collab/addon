<?xml version="1.0" encoding="UTF-8" ?>
<WidgetButton>
	<Name>OptionsButton</Name>
	<Priority>10</Priority>
	<Placement>
		<X>
			<Size>30</Size>
		</X>
		<Y>
			<Size>30</Size>
		</Y>
	</Placement>
	<IgnoreDblClick>true</IgnoreDblClick>
	<TextTag>button_label</TextTag>
	<Variants>
		<Item>
			<TextFileRef href="OptionsButton.txt" />
			<LayerHighlight href="ButtonRegularHighlighted.(WidgetLayerTiledTexture).xdb" />
			<PushedOffset x="-2" y="2" />
			<StateNormal>
				<LayerMain href="ButtonRegularNormal.(WidgetLayerTiledTexture).xdb" />
				<FormatFileRef href="ButtonFormatNormal.txt" />
			</StateNormal>
			<StatePushed>
				<LayerMain href="ButtonRegularPressed.(WidgetLayerTiledTexture).xdb" />
			</StatePushed>
			<Reaction>options_pressed</Reaction>
			<ReactionRightClick>ReactionRightClickButtonPressed</ReactionRightClick>
			<ReactionOnUp>true</ReactionOnUp>
		</Item>
		<Item>
			<TextFileRef href="OptionsButton.txt" />
			<LayerHighlight href="ButtonRegularHighlighted.(WidgetLayerTiledTexture).xdb" />
			<PushedOffset x="-2" y="2" />
			<StateNormal>
				<LayerMain href="ButtonRegularDisabled.(WidgetLayerTiledTexture).xdb" />
				<FormatFileRef href="ButtonFormatDisabled.txt" />
			</StateNormal>
			<StatePushed>
				<LayerMain href="ButtonRegularPressed.(WidgetLayerTiledTexture).xdb" />
			</StatePushed>
			<Reaction>options_pressed</Reaction>
			<ReactionRightClick>ReactionRightClickButtonPressed</ReactionRightClick>
			<ReactionOnUp>true</ReactionOnUp>
		</Item>
	</Variants>

	<TextStyle>
		<Align>ALIGNY_MIDDLE</Align>
	</TextStyle>
</WidgetButton>
